# ==========================================
# Web Runtime
# ==========================================
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8890
UI_HOST=127.0.0.1
UI_PORT=8051
# Optional Vite proxy target; when empty, FASTAPI_HOST and FASTAPI_PORT are used.
API_BASE_URL=
# Comma-separated browser origins allowed to call the API directly; leave empty for same-origin use.
CORS_ORIGINS=

# ==========================================
# API and Developer Experience
# ==========================================
ENABLE_API_DOCS=true
RELOAD=false

# ==========================================
# Storage
# ==========================================
# Optional data root for the embedded database, logs, and checkpoints.
# When empty, the application uses data.
FAIRS_DATA_DIR=

# ==========================================
# ML Runtime
# ==========================================
MPLBACKEND=Agg
KERAS_BACKEND=torch
# Optional CPU thread caps (uncomment to keep CPU-bound training from starving the API on busy hosts).
# Leave unset for the library defaults; lowering them can reduce CPU-only training throughput.
# OMP_NUM_THREADS=4
# MKL_NUM_THREADS=4
# OPENBLAS_NUM_THREADS=4
