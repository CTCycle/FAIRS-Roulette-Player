# ==========================================
# Web Runtime
# ==========================================
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8890
UI_HOST=127.0.0.1
UI_PORT=8051

# ==========================================
# API and Developer Experience
# ==========================================
ENABLE_API_DOCS=true
RELOAD=false

# ==========================================
# Storage
# ==========================================
# Optional data root for the embedded database, logs, and checkpoints.
# When empty, the application uses data.
FAIRS_DATA_DIR=

# ==========================================
# ML Runtime
# ==========================================
MPLBACKEND=Agg
KERAS_BACKEND=torch
