# ==========================================
# Web Runtime
# ==========================================
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8890
UI_HOST=127.0.0.1
UI_PORT=8051
# Set to true to open a dedicated terminal window showing backend logs.
# Defaults to true when absent.
BACKEND_LOGS_VISIBLE=true

# ==========================================
# API and Developer Experience
# ==========================================
ENABLE_API_DOCS=true
RELOAD=false

# ==========================================
# Storage
# ==========================================
# Optional resource root for the embedded database, logs, and checkpoints.
# Defaults to app\resources.
FAIRS_DATA_DIR=

# ==========================================
# Database
# ==========================================
EMBEDDED_DATABASE=true
DATABASE_ENGINE=postgresql+psycopg
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=FAIRS
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_SSL_CA=
DATABASE_CONNECT_TIMEOUT=30
DATABASE_INSERT_BATCH_SIZE=1000

# ==========================================
# ML Runtime
# ==========================================
MPLBACKEND=Agg
KERAS_BACKEND=torch
