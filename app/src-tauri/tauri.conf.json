{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FAIRS",
  "version": "2.4.0",
  "identifier": "com.fairs.roulette",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../client/dist",
    "devUrl": "about:blank"
  },
  "app": {
    "windows": [{ "label": "main", "title": "FAIRS", "url": "about:blank", "width": 1440, "height": 920, "center": true }],
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["../client/public/favicon.png"],
    "resources": { "runtime": "runtime" }
  }
}
