# Project-specific generated/runtime artifacts. All disposable cache data is
# owned by runtimes/cache; the generic cache rules below are defensive ignores
# for accidental tool output and do not define alternate cache locations.
runtimes/**
**/assets/QA/**
# Keep the cache roots available on a fresh checkout; generated cache contents remain ignored.
!runtimes/
!runtimes/cache/
!runtimes/cache/.gitkeep
!runtimes/cache/uv/
!runtimes/cache/uv/.gitkeep
!runtimes/cache/pytest-tmp/
!runtimes/cache/pytest-tmp/.gitkeep
app/resources/logs/**
app/resources/checkpoints/**
app/resources/runtime-settings.json
app/client/node_modules/
app/client/dist/
app/client/dist-ssr/
app/client/logs/
app/client/*.local


# Python
__pycache__/
.uv-cache/
*.py[cod]
*.egg-info/
app/server/.venv/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.coverage
.coverage
htmlcov/

# Node / JS
**/node_modules/
**/dist/
**/dist-ssr/
**/.angular/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
yarn.lock

# IDE / OS
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Misc
.env
*.log
*.db*
*.sqlite*
*.exe
*.gz
!.gitkeep


